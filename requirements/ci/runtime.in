# One hash-pinned lock for both the CI test job (Python 3.12) and the container
# image (python:3.15-slim), so CI tests exactly the pins the image ships.
# requirements.txt stays the single source of version ranges.
# Regenerate runtime.txt with:
#   uv pip compile --universal --generate-hashes --python-version 3.12 requirements/ci/runtime.in -o requirements/ci/runtime.txt
-r ../../requirements.txt
